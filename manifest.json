{
  "manifest_version": 2,
  "name": "Twitter/X to Nitter",
  "version": "1.3.0",
  "description": "Redirect Twitter/X pages to a working Nitter frontend.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "webNavigation",
    "webRequest",
    "tabs",
    "storage",
    "https://nitter.net/*",
    "https://nitter.poast.org/*",
    "https://nitter.privacyredirect.com/*",
    "https://xcancel.com/*",
    "https://lightbrd.com/*",
    "https://nitter.tiekoetter.com/*",
    "https://nitter.catsarch.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitter-to-nitter@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
