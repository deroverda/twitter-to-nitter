{
  "manifest_version": 2,
  "name": "Twitter/X to Nitter",
  "version": "1.4.0",
  "description": "Redirect Twitter/X pages to a working Nitter frontend.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "*://twitter.com/*",
    "*://www.twitter.com/*",
    "*://mobile.twitter.com/*",
    "*://x.com/*",
    "*://www.x.com/*",
    "*://mobile.x.com/*",
    "https://xcancel.com/*",
    "https://nitter.catsarch.com/*",
    "https://lightbrd.com/*",
    "https://nitter.kareem.one/*",
    "https://status.d420.de/api/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitter-to-nitter@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
